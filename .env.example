# ==============================================================================
# SCYPH FRAMEWORK CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to `.env` in your project root and update values as needed.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & TELEMETRY (scyph-core & scyph-telemetry)
# ------------------------------------------------------------------------------
# [Optional] Application environment mode:
# - 'development' / 'dev'  -> executes <dir>/beta subfolder for migrations & seeds
# - 'production' / 'prod'   -> executes <dir>/prod subfolder for migrations & seeds
# Default: development
APP_ENV=development

# [Optional] Server host bind address (Default: 127.0.0.1)
HOST=127.0.0.1

# [Optional] Server HTTP port (Default: 8080)
PORT=8080

# [Optional] Tracing and logging filter directives (Default: info)
# Examples: info, debug, scyph=debug, axum=trace
RUST_LOG=info

# [Optional] Structured log output format for scyph-telemetry
# Options: 'json' (structured production JSON logs) or 'pretty' (human-readable colored console logs)
# Default: json
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 2. DATABASE & MIGRATIONS (scyph-db feature)
# ------------------------------------------------------------------------------
# [Required if 'db' feature is enabled] PostgreSQL connection URL string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scyph_db

# [Optional] Maximum PostgreSQL pool connection limit (Default: 5)
MAX_CONNECTIONS=10

# [Optional] Minimum idle PostgreSQL pool connection limit (Default: 1)
MIN_CONNECTIONS=2

# [Optional] Custom directory path for SQL migrations (Default: ./migrations)
MIGRATIONS_DIR=./migrations

# [Optional] Custom directory path for seed data SQL files (Default: ./seeds)
SEEDS_DIR=./seeds

# [Optional] Set to 'true' or '1' to execute seed data scripts on startup (Default: false)
RUN_SEEDS=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (scyph-auth feature)
# ------------------------------------------------------------------------------
# [Required if 'auth' feature is enabled] Secret key used for signing & verifying JWT tokens
# Generate a secure key in production (e.g. `openssl rand -base64 32`)
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production_32bytes

# [Optional] JWT token validity duration in seconds (Default: 86400 = 24 hours)
JWT_EXPIRATION=86400

# [Optional] Additional pepper secret string for Argon2id password hashing
ARGON2_SECRET=optional_argon2id_pepper_secret_string

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE & TEMPLATES (scyph-notify 'email' feature)
# ------------------------------------------------------------------------------
# [Required if 'email' feature is enabled] SMTP server hostname
SMTP_HOST=smtp.mailgun.org

# [Required if 'email' feature is enabled] SMTP port (587 for StartTLS, 465 for SSL/TLS)
SMTP_PORT=587

# [Required if 'email' feature is enabled] SMTP account username
SMTP_USERNAME=postmaster@mg.example.com

# [Required if 'email' feature is enabled] SMTP account password (sensitive)
SMTP_PASSWORD=smtp_secret_password_here

# [Required if 'email' feature is enabled] Sender email address header
SMTP_FROM=noreply@example.com

# [Optional] Tera template search glob pattern for HTML & TXT templates (Default: templates/**/*)
TEMPLATES_DIR=templates/**/*

# ------------------------------------------------------------------------------
# 5. FCM PUSH NOTIFICATIONS (scyph-notify 'fcm' feature)
# ------------------------------------------------------------------------------
# [Required if 'fcm' feature is enabled] Google Firebase Cloud Messaging Project ID
FCM_PROJECT_ID=my-firebase-project-id

# [Required if 'fcm' feature is enabled] Raw JSON content of Google Service Account Credentials file
# Note: Provide as a single-line JSON string or escape double quotes appropriately
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-firebase-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@my-project.iam.gserviceaccount.com"}

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE & AWS S3 (scyph-storage 's3' feature)
# ------------------------------------------------------------------------------
# [Required if 's3' feature is enabled] Target S3/MinIO bucket name
S3_BUCKET=scyph-uploads

# [Optional] Public browser-accessible URL or CDN prefix for generated presigned links
# Examples: https://cdn.example.com, http://localhost:9000/scyph-uploads
# Default: Evaluates to S3 bucket endpoint
S3_PUBLIC_URL_PREFIX=http://localhost:9000/scyph-uploads

# [Optional] Custom internal S3 API endpoint URL (Required for MinIO, LocalStack, Wasabi, Cloudflare R2)
# Example for local MinIO: http://localhost:9000
# Default: AWS S3 standard regional endpoint
S3_ENDPOINT_URL=http://localhost:9000

# [Optional] AWS region for S3 bucket operations (Default: us-east-1)
S3_REGION=us-east-1

# [Optional] AWS Access Key ID (If omitted, uses AWS IAM instance role / AWS credentials provider chain)
AWS_ACCESS_KEY_ID=minioadmin

# [Optional] AWS Secret Access Key (If omitted, uses AWS IAM instance role / AWS credentials provider chain)
AWS_SECRET_ACCESS_KEY=minioadmin

# ------------------------------------------------------------------------------
# 7. REALTIME & REDIS PUB/SUB (scyph-realtime feature)
# ------------------------------------------------------------------------------
# [Required if 'realtime' feature is enabled] Redis connection URL string
# Fallback order: REALTIME_REDIS_URL -> REDIS_URL -> redis://127.0.0.1:6379
REALTIME_REDIS_URL=redis://127.0.0.1:6379

# [Optional] Pub/sub Redis channel prefix for event isolation (Default: scyph:realtime)
REALTIME_CHANNEL_PREFIX=scyph:realtime

# [Optional] Reconnect backoff interval in seconds when Redis subscriber stream drops (Default: 1)
REALTIME_RECONNECT_INTERVAL_SECS=1

# ------------------------------------------------------------------------------
# 8. RATE LIMITING (scyph-ratelimit feature)
# ------------------------------------------------------------------------------
# [Optional] Maximum allowed request burst capacity per IP (Default: 10)
RATE_LIMIT_BURST=10

# [Optional] Replenishment duration period in milliseconds (Default: 1000 = 1 second)
RATE_LIMIT_PERIOD_MS=1000

# ------------------------------------------------------------------------------
# 9. UTILITIES & API IDEMPOTENCY (scyph-utils feature)
# ------------------------------------------------------------------------------
# [Optional] Redis connection URL string for API idempotency store
# Fallback order: IDEMPOTENCY_REDIS_URL -> REDIS_URL -> redis://127.0.0.1:6379
IDEMPOTENCY_REDIS_URL=redis://127.0.0.1:6379

# [Optional] Key expiration time-to-live duration in seconds (Default: 86400 = 24 hours)
IDEMPOTENCY_TTL_SECS=86400

# [Optional] Redis key namespace prefix for idempotency reservations (Default: idem)
IDEMPOTENCY_PREFIX=idem

